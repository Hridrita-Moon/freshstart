@@ -0,0 +1,319 @@
+"use client";
+
+import { useRouter, useSearchParams } from "next/navigation";
+import { useState } from "react";
+import { AlertCircle, Loader2 } from "lucide-react";
+import { MIN_PASSWORD_LENGTH } from "@/lib/auth/password";
+
+/**
+ * AuthForm — the shared sign-in / sign-up form.
+ *
+ * SRS §9.2: the form is a Client Component; the pages around it are Server
+ * Components. The form talks to the two existing API routes:
+ *
+ * - `POST /api/auth/login` — sets the `ft_session` cookie.
+ * - `POST /api/auth/register` — creates the account *and* sets the cookie.
+ *
+ * The session token itself never reaches the client: it travels in the
+ * httpOnly cookie, so there is nothing to store in JavaScript.
+ */
+
+/** Where a visitor lands after a successful sign-in. */
+const DEFAULT_REDIRECT = "/app/products";
+
+/**
+ * Validate a `?next=` target.
+ *
+ * Only a single-slash-prefixed path is accepted. `//evil.example` is a
+ * protocol-relative URL that would redirect off-site, so it is rejected
+ * alongside anything that is not a path at all.
+ *
+ * @param {string | null} value
+ * @returns {string}
+ */
+export function safeRedirectPath(value) {
+  if (typeof value !== "string") return DEFAULT_REDIRECT;
+
+  const candidate = value.trim();
+
+  if (!candidate.startsWith("/")) return DEFAULT_REDIRECT;
+  if (candidate.startsWith("//")) return DEFAULT_REDIRECT;
+  if (candidate.includes("\\")) return DEFAULT_REDIRECT;
+  if (candidate.includes("\n") || candidate.includes("\r")) return DEFAULT_REDIRECT;
+
+  return candidate;
+}
+
+/**
+ * @param {object} props
+ * @param {"login" | "register"} props.mode
+ */
+export default function AuthForm({ mode }) {
+  const router = useRouter();
+  const searchParams = useSearchParams();
+
+  const isRegister = mode === "register";
+
+  const [name, setName] = useState("");
+  const [email, setEmail] = useState("");
+  const [password, setPassword] = useState("");
+  const [fieldErrors, setFieldErrors] = useState({});
+  const [generalError, setGeneralError] = useState("");
+  const [isPending, setIsPending] = useState(false);
+
+  const redirectTo = safeRedirectPath(searchParams.get("next"));
+
+  /**
+   * Turn the API's `details.issues[]` into a field → message map.
+   *
+   * @param {unknown} details
+   * @returns {Record<string, string>}
+   */
+  function issuesToFieldErrors(details) {
+    /** @type {Record<string, string>} */
+    const map = {};
+    const issues =
+      details && typeof details === "object" && Array.isArray(details.issues)
+        ? details.issues
+        : [];
+
+    for (const issue of issues) {
+      if (!issue || typeof issue !== "object") continue;
+      const path = typeof issue.path === "string" ? issue.path : "";
+      const message = typeof issue.message === "string" ? issue.message : "";
+      if (!path || !message) continue;
+      // The first issue per field wins — one message per input is enough.
+      if (!map[path]) map[path] = message;
+    }
+
+    return map;
+  }
+
+  /**
+   * @param {import("react").FormEvent<HTMLFormElement>} event
+   */
+  async function handleSubmit(event) {
+    event.preventDefault();
+
+    setGeneralError("");
+    setFieldErrors({});
+    setIsPending(true);
+
+    const endpoint = isRegister ? "/api/auth/register" : "/api/auth/login";
+    const payload = isRegister ? { name, email, password } : { email, password };
+
+    try {
+      const response = await fetch(endpoint, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify(payload),
+      });
+
+      let body = null;
+      try {
+        body = await response.json();
+      } catch {
+        body = null;
+      }
+
+      if (!response.ok) {
+        const error = body?.error;
+        const details = error?.details;
+
+        const fieldMap = issuesToFieldErrors(details);
+        if (Object.keys(fieldMap).length > 0) {
+          setFieldErrors(fieldMap);
+        }
+
+        setGeneralError(
+          typeof error?.message === "string" && error.message
+            ? error.message
+            : "Something went wrong. Please try again.",
+        );
+        return;
+      }
+
+      // The cookie is already set by the route; the redirect just needs the
+      // server components to re-read it.
+      router.push(redirectTo);
+      router.refresh();
+    } catch {
+      setGeneralError("Could not reach the server. Please try again.");
+    } finally {
+      setIsPending(false);
+    }
+  }
+
+  return (
+    <form onSubmit={handleSubmit} noValidate className="space-y-4">
+      {/* ── General error ────────────────────────────────────────────── */}
+      <div aria-live="polite" aria-atomic="true">
+        {generalError ? (
+          <p className="flex items-start gap-2 rounded-xl border border-expired-100 bg-expired-50 px-3.5 py-3 text-sm text-expired-800">
+            <AlertCircle className="mt-0.5 size-4 shrink-0" aria-hidden="true" />
+            <span>{generalError}</span>
+          </p>
+        ) : null}
+      </div>
+
+      {isRegister ? (
+        <Field
+          id="name"
+          label="Full name"
+          type="text"
+          autoComplete="name"
+          value={name}
+          onChange={(event) => setName(event.target.value)}
+          error={fieldErrors.name}
+          placeholder="Alice Rahman"
+        />
+      ) : null}
+
+      <Field
+        id="email"
+        label="Email"
+        type="email"
+        autoComplete="email"
+        value={email}
+        onChange={(event) => setEmail(event.target.value)}
+        error={fieldErrors.email}
+        placeholder="you@example.com"
+      />
+
+      <Field
+        id="password"
+        label="Password"
+        type="password"
+        autoComplete={isRegister ? "new-password" : "current-password"}
+        value={password}
+        onChange={(event) => setPassword(event.target.value)}
+        error={fieldErrors.password}
+        placeholder={isRegister ? "At least 8 characters" : "••••••••"}
+        hint={
+          isRegister
+            ? `Use at least ${MIN_PASSWORD_LENGTH} characters.`
+            : undefined
+        }
+      />
+
+      <button
+        type="submit"
+        disabled={isPending}
+        className="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:bg-sand-200 disabled:text-sand-400"
+      >
+        {isPending ? (
+          <>
+            <Loader2 className="size-4 animate-spin" aria-hidden="true" />
+            {isRegister ? "Creating your account…" : "Signing you in…"}
+          </>
+        ) : isRegister ? (
+          "Create account"
+        ) : (
+          "Sign in"
+        )}
+      </button>
+    </form>
+  );
+}
+
+/**
+ * A placeholder for the form while the client bundle boots.
+ *
+ * `useSearchParams()` forces the form to be client-rendered, so the page
+ * needs a `<Suspense>` boundary around it (Next.js prerender requirement).
+ * The skeleton mirrors the form's field count so the card does not jump
+ * when the real form replaces it.
+ *
+ * @param {object} props
+ * @param {boolean} [props.showName]
+ */
+export function AuthFormSkeleton({ showName = false }) {
+  const fieldCount = showName ? 3 : 2;
+
+  return (
+    <div aria-hidden="true">
+      {Array.from({ length: fieldCount }).map((_, index) => (
+        <div key={index} className="mt-4 first:mt-0">
+          <div className="h-4 w-24 rounded bg-sand-200" />
+          <div className="mt-1.5 h-10 w-full rounded-xl bg-sand-100" />
+        </div>
+      ))}
+      <div className="mt-4 h-10 w-full rounded-lg bg-sand-200" />
+    </div>
+  );
+}
+
+/**
+ * A labelled input with an optional hint and an inline error message.
+ *
+ * @param {object} props
+ * @param {string} props.id
+ * @param {string} props.label
+ * @param {string} props.type
+ * @param {string} props.value
+ * @param {(event: import("react").ChangeEvent<HTMLInputElement>) => void} props.onChange
+ * @param {string} props.autoComplete
+ * @param {string} [props.placeholder]
+ * @param {string} [props.hint]
+ * @param {string} [props.error]
+ */
+function Field({
+  id,
+  label,
+  type,
+  value,
+  onChange,
+  autoComplete,
+  placeholder,
+  hint,
+  error,
+}) {
+  const hintId = hint ? `${id}-hint` : undefined;
+  const errorId = error ? `${id}-error` : undefined;
+
+  return (
+    <div>
+      <label
+        htmlFor={id}
+        className="block text-sm font-medium text-sand-700"
+      >
+        {label}
+      </label>
+
+      <input
+        id={id}
+        name={id}
+        type={type}
+        value={value}
+        onChange={onChange}
+        autoComplete={autoComplete}
+        placeholder={placeholder}
+        aria-invalid={error ? "true" : undefined}
+        aria-describedby={
+          [hintId, errorId].filter(Boolean).join(" ") || undefined
+        }
+        className={`mt-1.5 w-full rounded-xl border bg-white py-2.5 px-3.5 text-sm text-sand-900 shadow-soft transition placeholder:text-sand-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 ${
+          error
+            ? "border-expired-500 focus:border-expired-500 focus:ring-expired-500/20"
+            : "border-sand-200 focus:border-brand-400 focus:ring-brand-500/20"
+        }`}
+      />
+
+      {hint ? (
+        <p id={hintId} className="mt-1.5 text-xs text-sand-500">
+          {hint}
+        </p>
+      ) : null}
+
+      {error ? (
+        <p
+          id={errorId}
+          className="mt-1.5 flex items-start gap-1.5 text-xs text-expired-700"
+        >
+          <AlertCircle className="mt-0.5 size-3.5 shrink-0" aria-hidden="true" />
+          <span>{error}</span>
+        </p>
+      ) : null}
+    </div>
+  );
+}
diff --git a/src/components/LogoutButton.jsx b/src/components/LogoutButton.jsx
new file mode 100644
index 0000000..3d59167
--- /dev/null
+++ b/src/components/LogoutButton.jsx
@@ -0,0 +1,54 @@
+"use client";
+
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+import { LogOut } from "lucide-react";
+
+/**
+ * LogoutButton — signs the visitor out.
+ *
+ * SRS §3.1: because sessions are server-side, logging out is immediate and
+ * global — the route deletes the session row and clears the `ft_session`
+ * cookie. The raw token never reaches JavaScript, so there is nothing to
+ * clean up on the client.
+ *
+ * After the request, the server components are refreshed so the Navbar
+ * re-renders in its signed-out state without a full page reload.
+ */
+export default function LogoutButton() {
+  const router = useRouter();
+  const [isPending, setIsPending] = useState(false);
+
+  /**
+   * @param {import("react").MouseEvent<HTMLButtonElement>} event
+   */
+  async function handleLogout(event) {
+    event.preventDefault();
+    setIsPending(true);
+
+    try {
+      await fetch("/api/auth/logout", { method: "POST" });
+    } catch {
+      // A failed logout must not trap the visitor on the page; the session
+      // cookie is still cleared by the browser on the next sign-in.
+    }
+
+    router.refresh();
+    router.push("/app/products");
+    setIsPending(false);
+  }
+
+  return (
+    <button
+      type="button"
+      onClick={handleLogout}
+      disabled={isPending}
+      className="inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-sand-600 transition hover:bg-sand-100 hover:text-sand-900 disabled:cursor-not-allowed disabled:opacity-60"
+    >
+      <LogOut className="size-4" aria-hidden="true" />
+      <span className="hidden sm:inline">
+        {isPending ? "Signing out…" : "Log out"}
+      </span>
+    </button>
+  );
+}
diff --git a/src/lib/validation/auth.js b/src/lib/validation/auth.js
new file mode 100644
index 0000000..0203c90
--- /dev/null
+++ b/src/lib/validation/auth.js
@@ -0,0 +1,89 @@
+import { MIN_PASSWORD_LENGTH, meetsPasswordPolicy } from "@/lib/auth/password";
+import { Validator, finish, requireString } from "@/lib/validation/schema";
+
+/**
+ * Authentication input validation.
+ *
+ * SRS §3.1 / §4.2: an account is identified by a unique, normalised email
+ * address and protected by a password. Registration is open to the public and
+ * always creates a *customer* account — the caller never chooses a role.
+ *
+ * The validators follow the house pattern from `src/lib/validation/product.js`:
+ * a `Validator` accumulates issues, the primitives mutate it and return the
+ * trimmed value (or `undefined` on failure), and `finish` turns the run into
+ * a `{ success, data }` / `{ success, errors }` result.
+ */
+
+/**
+ * @typedef {object} RegisterInput
+ * @property {string} name
+ * @property {string} email
+ * @property {string} password
+ */
+
+/**
+ * @typedef {object} LoginInput
+ * @property {string} email
+ * @property {string} password
+ */
+
+/** Pragmatic email shape check — one `@`, a dotted domain, no whitespace. */
+const EMAIL_PATTERN = /^[^\s@]+@[^\s@.]+(\.[^\s@.]+)+$/;
+
+/**
+ * Maximum lengths. The email limit matches the database column budget; the
+ * password limit keeps an oversized value out of the bcrypt work factor.
+ */
+const MAX_EMAIL_LENGTH = 255;
+const MAX_PASSWORD_LENGTH = 128;
+
+/**
+ * Validate a registration payload.
+ *
+ * @param {unknown} body
+ * @returns {import("@/lib/validation/schema").ValidationResult<RegisterInput>}
+ */
+export function validateRegisterInput(body) {
+  const v = new Validator();
+  const input = /** @type {Record<string, unknown>} */ (body ?? {});
+
+  const name = requireString(v, input.name, "name", { min: 2, max: 120 });
+
+  const email = requireString(v, input.email, "email", { min: 3, max: MAX_EMAIL_LENGTH });
+  if (email !== undefined && !EMAIL_PATTERN.test(email)) {
+    v.add("email", "Must be a valid email address.");
+  }
+
+  const password = requireString(v, input.password, "password", {
+    min: MIN_PASSWORD_LENGTH,
+    max: MAX_PASSWORD_LENGTH,
+  });
+  if (password !== undefined && !meetsPasswordPolicy(password)) {
+    v.add("password", `Must be at least ${MIN_PASSWORD_LENGTH} characters.`);
+  }
+
+  return finish(v, { name, email, password });
+}
+
+/**
+ * Validate a login payload.
+ *
+ * Presence only — the format is deliberately *not* checked, because an
+ * unknown email and a malformed email must produce the same `401` response
+ * as a wrong password. The route owns that decision.
+ *
+ * @param {unknown} body
+ * @returns {import("@/lib/validation/schema").ValidationResult<LoginInput>}
+ */
+export function validateLoginInput(body) {
+  const v = new Validator();
+  const input = /** @type {Record<string, unknown>} */ (body ?? {});
+
+  const email = requireString(v, input.email, "email", { min: 1, max: MAX_EMAIL_LENGTH });
+  const password = requireString(v, input.password, "password", {
+    min: 1,
+    max: MAX_PASSWORD_LENGTH,
+  });
+
+  return finish(v, { email, password });
+}
diff --git a/tests/auth-login.test.js b/tests/auth-login.test.js
new file mode 100644
index 0000000..7a464d2
--- /dev/null
+++ b/tests/auth-login.test.js
@@ -0,0 +1,176 @@
+import { describe, it, expect, beforeEach, afterAll, vi } from "vitest";
+import { prisma } from "@/lib/prisma";
+import { hashPassword } from "@/lib/auth/password";
+import { SESSION_COOKIE_NAME } from "@/lib/auth/session";
+
+/**
+ * Integration tests for `POST /api/auth/login` and `POST /api/auth/logout`.
+ *
+ * These routes predate the authentication UI, but the story's I/O matrix
+ * lists their behaviours, so they are pinned here rather than left implicit.
+ *
+ * The session module imports `next/headers`, so it is mocked to allow the
+ * handlers to be invoked outside a request scope.
+ */
+vi.mock("next/headers", () => ({
+  cookies: vi.fn(async () => ({
+    get: () => undefined,
+    set: () => {},
+    delete: () => {},
+  })),
+}));
+
+const { POST: login } = await import("@/app/api/auth/login/route");
+const { POST: logout } = await import("@/app/api/auth/logout/route");
+
+const EMAIL = "login.test@test.local";
+const PASSWORD = "tomatoes";
+
+/**
+ * @param {unknown} body
+ * @param {string} [cookie]
+ * @returns {Request}
+ */
+function jsonRequest(body, cookie) {
+  return new Request("http://localhost/api/auth/login", {
+    method: "POST",
+    headers: {
+      "Content-Type": "application/json",
+      ...(cookie ? { cookie } : {}),
+    },
+    body: JSON.stringify(body),
+  });
+}
+
+beforeEach(async () => {
+  await prisma.session.deleteMany();
+  await prisma.user.deleteMany({ where: { email: EMAIL } });
+});
+
+afterAll(async () => {
+  await prisma.session.deleteMany();
+  await prisma.user.deleteMany({ where: { email: EMAIL } });
+  await prisma.$disconnect();
+});
+
+/**
+ * Seed a user with the given status.
+ *
+ * @param {string} status
+ */
+async function seedUser(status) {
+  const passwordHash = await hashPassword(PASSWORD);
+
+  return prisma.user.create({
+    data: { email: EMAIL, passwordHash, name: "Login Tester", status },
+  });
+}
+
+describe("POST /api/auth/login", () => {
+  it("signs in an active user and sets the session cookie", async () => {
+    await seedUser("active");
+
+    const response = await login(jsonRequest({ email: EMAIL, password: PASSWORD }));
+    const body = await response.json();
+
+    expect(response.status).toBe(200);
+    expect(body.data.email).toBe(EMAIL);
+    expect(body.data.role).toBe("customer");
+    expect(body.error).toBeUndefined();
+
+    const setCookie = response.headers.get("set-cookie") ?? "";
+    expect(setCookie).toContain(`${SESSION_COOKIE_NAME}=`);
+    expect(setCookie).toContain("HttpOnly");
+    expect(/SameSite=lax/i.test(setCookie)).toBe(true);
+  });
+
+  it("rejects a wrong password with 401 and sets no cookie", async () => {
+    await seedUser("active");
+
+    const response = await login(jsonRequest({ email: EMAIL, password: "wrong-password" }));
+    const body = await response.json();
+
+    expect(response.status).toBe(401);
+    expect(body.error.code).toBe("unauthenticated");
+    expect(response.headers.get("set-cookie") ?? "").not.toContain(
+      `${SESSION_COOKIE_NAME}=`,
+    );
+  });
+
+  it("rejects an unknown email with 401 and the same message as a wrong password", async () => {
+    await seedUser("active");
+
+    const unknown = await login(
+      jsonRequest({ email: "nobody@test.local", password: PASSWORD }),
+    );
+    const unknownBody = await unknown.json();
+
+    const wrong = await login(
+      jsonRequest({ email: EMAIL, password: "wrong-password" }),
+    );
+    const wrongBody = await wrong.json();
+
+    expect(unknown.status).toBe(401);
+    expect(wrong.status).toBe(401);
+    // The two must be indistinguishable, so the response cannot reveal
+    // which accounts exist.
+    expect(unknownBody.error.message).toBe(wrongBody.error.message);
+    expect(unknownBody.error.code).toBe(wrongBody.error.code);
+  });
+
+  it("rejects a suspended account with 403 and sets no cookie", async () => {
+    await seedUser("suspended");
+
+    const response = await login(jsonRequest({ email: EMAIL, password: PASSWORD }));
+    const body = await response.json();
+
+    expect(response.status).toBe(403);
+    expect(body.error.code).toBe("forbidden");
+    expect(response.headers.get("set-cookie") ?? "").not.toContain(
+      `${SESSION_COOKIE_NAME}=`,
+    );
+  });
+
+  it("revokes a suspended account's existing sessions", async () => {
+    const user = await seedUser("active");
+
+    const signedIn = await login(jsonRequest({ email: EMAIL, password: PASSWORD }));
+    const cookie = (signedIn.headers.get("set-cookie") ?? "").split(";")[0];
+
+    expect(await prisma.session.count({ where: { userId: user.id } })).toBe(1);
+
+    await prisma.user.update({
+      where: { id: user.id },
+      data: { status: "suspended" },
+    });
+
+    // Logging in again clears the old sessions rather than stacking a new one.
+    await login(jsonRequest({ email: EMAIL, password: PASSWORD }));
+
+    expect(await prisma.session.count({ where: { userId: user.id } })).toBe(1);
+    expect(cookie).toContain(`${SESSION_COOKIE_NAME}=`);
+  });
+});
+
+describe("POST /api/auth/logout", () => {
+  it("clears the cookie and deletes the session row", async () => {
+    const user = await seedUser("active");
+
+    const signedIn = await login(jsonRequest({ email: EMAIL, password: PASSWORD }));
+    const cookie = (signedIn.headers.get("set-cookie") ?? "").split(";")[0];
+
+    expect(await prisma.session.count({ where: { userId: user.id } })).toBe(1);
+
+    const response = await logout(
+      new Request("http://localhost/api/auth/logout", {
+        method: "POST",
+        headers: { cookie },
+      }),
+    );
+
+    expect(response.status).toBe(200);
+
+    // The cookie is expired immediately, not merely emptied.
+    expect(/Max-Age=0/i.test(response.headers.get("set-cookie") ?? "")).toBe(true);
+  });
+});
