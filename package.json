  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@prisma/client": "^6.4.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.4.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
